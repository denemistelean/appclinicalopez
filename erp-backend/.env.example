# ==============================================
#  CLÍNICA LÓPEZ
# ==============================================
# Marcador local. No arranca la API. Genera al menos 32 caracteres aleatorios solo en .env.
JWT_SECRET=DEFINIR_LOCALMENTE
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Puerto distinto a Repuestos (3778) y CiberCafé (3788)
PORT=3789
API_PREFIX=api

# Desarrollo y arranque TCP: si HOST se omite, la API escucha solo en 127.0.0.1.
# Producción TCP: HOST es obligatorio. 0.0.0.0 y :: se rechazan.
# Con Phusion Passenger no hay bind TCP y HOST no se usa. El global lo inyecta Passenger.
# HOST=127.0.0.1

# Vacío no significa producción. El despliegue debe definir NODE_ENV=production.
# NODE_ENV=development

CORS_ORIGINS=http://localhost:4202

# Cookies. Solo se aceptan true o false, y lax, strict o none.
# En producción Secure queda activo. COOKIE_SECURE=false impide el arranque.
# SameSite por defecto es lax. No usar none sin HTTPS y orígenes separados.
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=true

# ==============================================
#  BASE DE DATOS
# ==============================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=app_clinica_lopez

# ==============================================
#  CORREOS (SMTP)
# ==============================================
SMTP_HOST=CAMBIAR
SMTP_PORT=465
SMTP_USER=CAMBIAR
SMTP_PASS=CAMBIAR
SMTP_FROM="Clínica López <noreply@clinicalopez.local>"

FRONTEND_URL=http://localhost:4202
# En producción es obligatoria y no puede ser localhost ni 127.0.0.1.
# Si falta en desarrollo, los enlaces de correo usan http://localhost:4202.

# Expedientes. El valor de abajo es solo el respaldo de desarrollo en Windows.
# En producción es obligatorio, absoluto y fuera de public_html, htdocs y de uploads.
# Una ruta de Windows impide el arranque en Linux. No hay ruta de servidor por defecto.
DOCUMENTOS_ROOT=D:\xampp\htdocs\appClinicaLopez\storage\ClinicaDigital

# Consulta oficial de DNI para la historia digital de Sorela.
# Si se omiten, el botón informa que el servicio no está configurado y los datos se completan a mano.
# RENIEC_API_URL debe ser HTTPS y devolver JSON con nombres, apellidos y fecha_nacimiento.
# RENIEC_API_URL=
# RENIEC_API_TOKEN=
